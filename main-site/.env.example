# The environment variables the site's Vercel functions (api/) read. All three are for the
# Android app only; the website itself needs none.
#
# In production these live in Vercel: the project's Settings > Environment Variables, each
# marked Sensitive, then redeploy (android/FIREBASE-SETUP.md, step 4). To run the functions
# locally with `vercel dev`, copy this file to .env and fill it in. .env is never committed
# (.gitignore); this example is, so keep real values out of it.

# The UwU Apps Firebase project's service account key for uwuFlash (uwuflash-push), which lets
# api/push/release.js send "new version" notifications through FCM (api/_lib/fcm.js). The whole
# JSON key file on one line, from { to }, or the file base64'd.
# Without it the webhook answers 502 and nothing is sent.
FIREBASE_SERVICE_ACCOUNT=

# The secret GitHub signs each release webhook delivery with, the same as in the repository's
# webhook settings (android/FIREBASE-SETUP.md, step 5). A long random string.
# Without it every delivery is refused as 401.
GITHUB_WEBHOOK_SECRET=

# Optional. A GitHub fine-grained token with read-only access to public repositories, which
# raises GitHub's rate limit for the update check (api/_lib/release.js) from 60 requests an hour
# to 5,000. The answer is cached for 10 minutes, so it's rarely needed.
GITHUB_TOKEN=
